{
	"name": "PhoneLinks",
	"version": "1.0.0",
	"author": [
		"Dror S. [FFS] ([http://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-PhoneLinks",
	"descriptionmsg": "phonelinks-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PhoneLinks\\": "src/"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikiRights/PhoneLinks/resources"
	},
	"ResourceModules": {
		"ext.phoneLinks.styles": {
			"styles": "ext.phoneLinks.styles.less"
		}
	},
	"config": {
		"PhoneLinksHideOnMobile": {
			"value": false,
			"description": "Whether to hide phone links on mobile devices"
		},
		"PhoneLinksHideOnDesktop": {
			"value": true,
			"description": "Whether to hide phone links on desktop devices"
		}
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\PhoneLinks\\Hooks",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"LinkerMakeExternalLink": "main",
		"BeforePageDisplay": "main"
	},
	"MessagesDirs": {
		"PhoneLinks": [
			"i18n"
		]
	},
	"manifest_version": 2
}
